{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "apple-docs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@kimsungwhee/apple-docs-mcp"
      ],
      "enabled": false
    },
    "blender": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/Users/dozer/Repos/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ],
      "enabled": false
    },
    "xcode": {
      "type": "local",
      "command": [
        "xcrun",
        "mcpbridge"
      ],
      "enabled": false
    },
    "davinci-resolve": {
      "type": "local",
      "enabled": false,
      "command": [
        "/Users/dozer/Library/Application Support/davinci-resolve-mcp/venv/bin/python",
        "/Users/dozer/Library/Application Support/davinci-resolve-mcp/src/server.py"
      ],
      "environment": {
        "RESOLVE_SCRIPT_API": "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting",
        "RESOLVE_SCRIPT_LIB": "/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so",
        "PYTHONPATH": "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting/Modules"
      }
    }
  },
  "model": "lmstudio/qwen/qwen3.6-35b-a3b",
  "small_model": "lmstudio/nvidia/nemotron-3-nano-4b",
  "autoupdate": false,
  "default_agent": "plan",
  "share": "disabled",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "qwen3.6-35b-a3b",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "qwen/qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "nvidia/nemotron-3-nano-4b": {
          "name": "nemotron-3-nano",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "tencent/hy-mt2-7b": {
          "name": "hy-mt2-7b",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "unsloth-studio": {
      "name": "Unsloth Studio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8888/v1/"
      },
      "models": {
        "unsloth/Qwen3.8-Flash-Next-GGUF": {
          "name": "Qwen3.8-Flash-Next",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    }
  },
  "disabled_providers": []
}
