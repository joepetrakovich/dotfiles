{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen/qwen3.6-35b-a3b",
  "default_agent": "plan",
  "share": "disabled",
  "update": "disable",
  "providers": {
    "lmstudio": {
      "name": "LM Studio",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "sk-lm-CxTKfXB1:AG09E0rgoi5A16y7unPh" //safe to put this as its just a local key for testing
      }
    },
    "unsloth-studio": {
      "name": "Unsloth Studio",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8888/v1/"
      },
      "models": {
        "unsloth/Qwen3.8-Flash-Next-GGUF": {
          "name": "Qwen3.8-Flash-Next",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "variants": [
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "none",
              "settings": {
                "reasoningEffort": "none"
              }
            }
          ]
        }
      }
    }
  },
  "disabled_providers": [],
  "agents": {
    "title": {
      "model": "lmstudio/nvidia/nemotron-3-nano-4b"
    }
  },
  "mcp": {
    "servers": {
      "apple-docs": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@kimsungwhee/apple-docs-mcp"
        ],
        "disabled": true
      },
      "blender": {
        "type": "local",
        "command": [
          "uv",
          "--directory",
          "/Users/dozer/Repos/blender_mcp/mcp",
          "run",
          "blender-mcp"
        ],
        "disabled": true
      },
      "xcode": {
        "type": "local",
        "command": [
          "xcrun",
          "mcpbridge"
        ],
        "disabled": true
      },
      "davinci-resolve": {
        "type": "local",
        "disabled": true,
        "command": [
          "/Users/dozer/Library/Application Support/davinci-resolve-mcp/venv/bin/python",
          "/Users/dozer/Library/Application Support/davinci-resolve-mcp/src/server.py"
        ],
        "environment": {
          "RESOLVE_SCRIPT_API": "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting",
          "RESOLVE_SCRIPT_LIB": "/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so",
          "PYTHONPATH": "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting/Modules"
        }
      },
      "chrome-devtools": {
        "type": "local",
        "disabled": true,
        "command": [
          "npx",
          "chrome-devtools-mcp@latest",
          "--browser-url=http://127.0.0.1:9222"
        ]
      },
      "touchdesigner": {
        "type": "local",
        "disabled": true,
        "command": [
          "npx",
          "-y",
          "touchdesigner-mcp-server@latest",
          "--stdio"
        ]
      }
    }
  },
}
